// ───────────────────────────────────────────────────────────────────────────
//  HOARD — Prisma schema
//
//  Design note: media is NOT stored in a single polymorphic table. Each media
//  category gets its own first-class relational table (Book, Movie, TvShow,
//  Anime, Manga, VideoGame, MusicAlbum) so we never compare apples to oranges.
//  `UserMediaActivity` is the join layer that ties a User to exactly one media
//  row (via one of seven nullable foreign keys) and carries the per-user state:
//  status, 0.0–10.0 score, tier, queue position, and the hidden Elo score that
//  drives the Arena ranking.
// ───────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; the explicit arm64 target ensures the engine is
  // present when the image is built on (or for) a Raspberry Pi.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaCategory {
  BOOK
  MOVIE
  TV
  ANIME
  MANGA
  GAME
  MUSIC
}

enum Tier {
  S
  A
  B
  C
  D
  F
}

enum MediaStatus {
  PLANNED
  CONSUMING
  COMPLETED
  DROPPED
  ON_HOLD
  RETIRED // set aside for good without finishing (1.12); tier-eligible like DROPPED
}

// ── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  // Per-user settings, typed and defaulted by src/lib/prefs.ts (unknown keys dropped).
  prefs        Json     @default("{}")

  sessions      Session[]
  activities    UserMediaActivity[]
  franchises    Franchise[]
  events        ActivityEvent[]
  notifications Notification[]
  diaryEntries  DiaryEntry[]
  playSessions  PlaySession[]
  seasonActivities SeasonActivity[]
}

model Session {
  id        String   @id // opaque random token, also the cookie value
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Media tables ───────────────────────────────────────────────────────────
//  Every media table shares a common display core (externalId, title, imageUrl,
//  description, year) plus category-specific extras. The shared core lets the UI
//  render any category uniformly while the join include stays trivial.

model Book {
  id          String   @id @default(cuid())
  externalId  String   @unique // OpenLibrary work/edition key
  title       String
  imageUrl    String?
  description String?
  year        Int?
  authors     String[]
  pageCount   Int?
  isbn        String?
  createdAt   DateTime @default(now())

  // Franchise detection, computed once per catalogue row (null = not resolved
  // yet). franchiseKey is a provider id like "anilist:123" / "tmdb-col:10".
  franchiseKey  String?
  franchiseName String?

  // F2 details: release date (YYYY-MM-DD when the full day is known; partial
  // provider dates keep only `year`), genres, and when they were last fetched.
  releaseDate   String?
  genres        String[]
  metaFetchedAt DateTime?
  // Last failed lookup (metadata job); such rows wait 3 days and go last.
  metaFailedAt  DateTime?

  activities UserMediaActivity[]
}

model Movie {
  id          String   @id @default(cuid())
  externalId  String   @unique // TMDB movie id
  title       String
  imageUrl    String?
  description String?
  year        Int?
  runtime     Int?
  backdropUrl String?
  tmdbRating  Float?
  createdAt   DateTime @default(now())

  // Franchise detection, computed once per catalogue row (null = not resolved
  // yet). franchiseKey is a provider id like "anilist:123" / "tmdb-col:10".
  franchiseKey  String?
  franchiseName String?

  // F2 details: release date (YYYY-MM-DD when the full day is known; partial
  // provider dates keep only `year`), genres, and when they were last fetched.
  releaseDate   String?
  genres        String[]
  metaFetchedAt DateTime?
  // Last failed lookup (metadata job); such rows wait 3 days and go last.
  metaFailedAt  DateTime?
  // Credits (5.10 / 6.6): directors and the top 5 billed cast.
  directors     String[]
  cast          String[]

  activities UserMediaActivity[]
}

model TvShow {
  id           String   @id @default(cuid())
  externalId   String   @unique // TMDB tv id
  title        String
  imageUrl     String?
  description  String?
  year         Int?
  episodeCount Int?
  seasonCount  Int?
  tmdbRating   Float?
  createdAt    DateTime @default(now())

  // Franchise detection, computed once per catalogue row (null = not resolved
  // yet). franchiseKey is a provider id like "anilist:123" / "tmdb-col:10".
  franchiseKey  String?
  franchiseName String?

  // F2 details: release date (YYYY-MM-DD when the full day is known; partial
  // provider dates keep only `year`), genres, and when they were last fetched.
  releaseDate   String?
  genres        String[]
  metaFetchedAt DateTime?
  // Last failed lookup (metadata job); such rows wait 3 days and go last.
  metaFailedAt  DateTime?
  // Credits (5.10 / 6.6): creators and the top 5 billed cast.
  directors     String[]
  cast          String[]
  status        String? // TMDB: Returning Series | Ended | Canceled | …
  nextAirDate   String? // YYYY-MM-DD of the next episode, when announced

  activities UserMediaActivity[]
  seasons    TvSeason[]

  @@map("TVShow")
}

model Anime {
  id          String   @id @default(cuid())
  externalId  String   @unique // MyAnimeList id (via Jikan)
  title       String
  imageUrl    String?
  description String?
  year        Int?
  episodes    Int?
  malScore    Float?
  studio      String?
  createdAt   DateTime @default(now())

  // Franchise detection, computed once per catalogue row (null = not resolved
  // yet). franchiseKey is a provider id like "anilist:123" / "tmdb-col:10".
  franchiseKey  String?
  franchiseName String?

  // F2 details: release date (YYYY-MM-DD when the full day is known; partial
  // provider dates keep only `year`), genres, and when they were last fetched.
  releaseDate       String?
  genres            String[]
  metaFetchedAt     DateTime?
  // Last failed lookup (metadata job); such rows wait 3 days and go last.
  metaFailedAt      DateTime?
  // AniList title variants (4.9), shown per prefs.titleLanguage.
  titleEnglish      String?
  titleRomaji       String?
  titleNative       String?
  nextAiringAt      DateTime?
  nextAiringEpisode Int?

  activities UserMediaActivity[]
}

model Manga {
  id          String   @id @default(cuid())
  externalId  String   @unique // MyAnimeList id (via Jikan)
  title       String
  imageUrl    String?
  description String?
  year        Int?
  chapters    Int?
  volumes     Int?
  malScore    Float?
  createdAt   DateTime @default(now())

  // Franchise detection, computed once per catalogue row (null = not resolved
  // yet). franchiseKey is a provider id like "anilist:123" / "tmdb-col:10".
  franchiseKey  String?
  franchiseName String?

  // F2 details: release date (YYYY-MM-DD when the full day is known; partial
  // provider dates keep only `year`), genres, and when they were last fetched.
  releaseDate   String?
  genres        String[]
  metaFetchedAt DateTime?
  // Last failed lookup (metadata job); such rows wait 3 days and go last.
  metaFailedAt  DateTime?
  // AniList title variants (4.9), shown per prefs.titleLanguage.
  titleEnglish  String?
  titleRomaji   String?
  titleNative   String?

  activities UserMediaActivity[]
}

model VideoGame {
  id          String   @id @default(cuid())
  externalId  String   @unique // IGDB id
  title       String
  imageUrl    String?
  description String?
  year        Int?
  platforms   String[]
  igdbRating  Float?
  createdAt   DateTime @default(now())

  // Franchise detection, computed once per catalogue row (null = not resolved
  // yet). franchiseKey is a provider id like "anilist:123" / "tmdb-col:10".
  franchiseKey  String?
  franchiseName String?

  // F2 details: release date (YYYY-MM-DD when the full day is known; partial
  // provider dates keep only `year`), genres, and when they were last fetched.
  releaseDate     String?
  genres          String[]
  metaFetchedAt   DateTime?
  // Last failed lookup (metadata job); such rows wait 3 days and go last.
  metaFailedAt    DateTime?
  timeToBeatHours Float? // IGDB game_time_to_beats.normally, in hours (5.3)
  steamAppId      Int?

  activities UserMediaActivity[]
}

model MusicAlbum {
  id          String   @id @default(cuid())
  externalId  String   @unique // MusicBrainz id or "artist::album" from Last.fm
  title       String
  imageUrl    String?
  description String?
  year        Int?
  artist      String?
  trackCount  Int?
  createdAt   DateTime @default(now())

  // Franchise detection, computed once per catalogue row (null = not resolved
  // yet). franchiseKey is a provider id like "anilist:123" / "tmdb-col:10".
  franchiseKey  String?
  franchiseName String?

  // F2 details: release date (YYYY-MM-DD when the full day is known; partial
  // provider dates keep only `year`), genres, and when they were last fetched.
  releaseDate   String?
  genres        String[]
  metaFetchedAt DateTime?
  // Last failed lookup (metadata job); such rows wait 3 days and go last.
  metaFailedAt  DateTime?

  activities UserMediaActivity[]
}

// ── The join layer ───────────────────────────────────────────────────────────

model UserMediaActivity {
  id         String        @id @default(cuid())
  userId     String
  category   MediaCategory
  status     MediaStatus   @default(PLANNED)
  rating     Float? // user score, 0.0–10.0
  tier       Tier?
  queueOrder Float? // position in the "Up next" queue (asc); null = not queued
  elo        Float         @default(1200) // hidden Arena rating
  duels      Int           @default(0) // Arena duels fought (4.3: confidence)
  rankOrder  Float? // position in the user's manual ranking (asc); null = unranked
  progress   Int? // pages / chapters / episodes / tracks done (1.4); null = not tracked
  tags       String[] // free-form labels (4.2); imported shelves land here (2.3)
  favorite   Boolean       @default(false)
  notes      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Exactly one of these is set, matching `category`.
  bookId       String?
  movieId      String?
  tvShowId     String?
  animeId      String?
  mangaId      String?
  videoGameId  String?
  musicAlbumId String?

  // Franchise / IP grouping. `franchiseLocked` = the user set this by hand, so
  // automatic detection must never move it.
  franchiseId     String?
  franchiseLocked Boolean @default(false)

  // 3.5 ownership and format: the platforms a game is owned on (IGDB names or
  // free text), and print|ebook|audio (books, manga) or vinyl|cd|digital (music).
  ownedPlatforms String[]
  format         String?
  // 3.1: a repeat run is in progress; the next finish logs a rewatch.
  rewatching     Boolean  @default(false)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  franchise  Franchise?  @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  book       Book?       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  movie      Movie?      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  tvShow     TvShow?     @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  anime      Anime?      @relation(fields: [animeId], references: [id], onDelete: Cascade)
  manga      Manga?      @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  videoGame  VideoGame?  @relation(fields: [videoGameId], references: [id], onDelete: Cascade)
  musicAlbum MusicAlbum? @relation(fields: [musicAlbumId], references: [id], onDelete: Cascade)

  events       ActivityEvent[]
  diaryEntries DiaryEntry[]
  playSessions PlaySession[]
  seasons      SeasonActivity[]

  // A user can only add a given media item once per category.
  @@unique([userId, bookId])
  @@unique([userId, movieId])
  @@unique([userId, tvShowId])
  @@unique([userId, animeId])
  @@unique([userId, mangaId])
  @@unique([userId, videoGameId])
  @@unique([userId, musicAlbumId])
  @@index([userId, category])
  @@index([userId, category, rating])
  @@index([userId, category, rankOrder])
  @@index([userId, category, queueOrder])
  @@index([franchiseId])
}

// ── Event log ────────────────────────────────────────────────────────────────
//  One row per change to an activity (added, status, score, tier, queue, …),
//  written in the same transaction as the change by src/lib/events.ts. `from`
//  and `to` are the before/after values as strings (null = unset).

model ActivityEvent {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  kind       String // added|status|score|progress|tier|queue|removed-undone|rewatch|review|import
  from       String?
  to         String?
  at         DateTime @default(now())
  meta       Json?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity UserMediaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([activityId, at])
}

// ── TV seasons (3.3 / 4.5) ──────────────────────────────────────────────────
//  TvSeason is catalogue data from TMDB `/tv/{id}` (specials, season 0, are
//  skipped). SeasonActivity is one user's tracking of one season, created
//  lazily on first interaction and owned through its parent activity:
//  watched episodes (a count, or episode ticks in `episodesWatched`), a score,
//  and the season tier list / Arena fields.

model TvSeason {
  id           String  @id @default(cuid())
  tvShowId     String
  seasonNumber Int
  name         String
  episodeCount Int?
  airDate      String? // YYYY-MM-DD
  imageUrl     String?

  tvShow     TvShow           @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  activities SeasonActivity[]

  @@unique([tvShowId, seasonNumber])
}

model SeasonActivity {
  id              String  @id @default(cuid())
  userId          String
  activityId      String
  seasonId        String
  watchedEpisodes Int     @default(0)
  episodesWatched Int[] // ticked episode numbers, sorted and unique
  rating          Float?
  tier            Tier?
  rankOrder       Float?
  elo             Float   @default(1200)
  duels           Int     @default(0)

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity UserMediaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  season   TvSeason          @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([activityId])
}

// ── Diary and play sessions ─────────────────────────────────────────────────
//  One DiaryEntry per finished run (3.1 / 3.4): written when a title is
//  finished (src/lib/diary.ts), by imports with dated logs, and by hand on
//  /diary. `date` is a calendar day in the user's time zone (G10).
//  PlaySession (3.6) is one sitting of a game.

model DiaryEntry {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  date       String // YYYY-MM-DD
  rating     Float?
  rewatch    Boolean  @default(false)
  review     String?
  createdAt  DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity UserMediaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([activityId, date])
}

model PlaySession {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  date       String // YYYY-MM-DD
  minutes    Int?
  note       String?
  createdAt  DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity UserMediaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([activityId, date])
}

// ── Franchises ───────────────────────────────────────────────────────────────
//  A per-user grouping of titles from one IP (e.g. every Haikyuu season, movie
//  and the manga). Carries its OWN rating and ranking, independent of the
//  members' individual ratings.

model Franchise {
  id        String   @id @default(cuid())
  userId    String
  name      String
  matchName String // normalised name used for automatic matching
  imageUrl  String?
  rating    Float? // the user's score of the IP as a whole, 0.0–10.0
  elo       Float    @default(1200)
  rankOrder Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities UserMediaActivity[]

  @@unique([userId, matchName])
  @@index([userId])
}

// ── Notifications ────────────────────────────────────────────────────────────
//  Shown in-app (the bell) and, when the user configured them, pushed to their
//  own ntfy topic and/or Discord webhook by src/lib/notify.ts. `sentAt` is set
//  once at least one push succeeded; `error` records failed pushes.

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // releases|new-seasons|backup|sync|list-shared|test
  title     String
  body      String
  url       String?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  sentAt    DateTime?
  error     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ── Scheduled jobs ───────────────────────────────────────────────────────────
//  One row per job name (src/lib/jobs/scheduler.ts): the last run's start time,
//  outcome and duration. Also drives "catch up after a restart".

model JobRun {
  name           String   @id
  lastRunAt      DateTime
  lastStatus     String // ok|error|seeded (first sighting; runs at its next slot)
  lastError      String?
  lastDurationMs Int      @default(0)
}
