# ──────────────────────────────────────────────────────────────────────────
#  HOARD — environment configuration
#  Copy this file to `.env` and fill in your keys. docker-compose reads `.env`.
# ──────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# These three feed the `db` container. POSTGRES_* and DATABASE_URL must agree.
POSTGRES_USER=hoard
POSTGRES_PASSWORD=change_me_to_something_secret
POSTGRES_DB=hoard
# The app connects to the compose service named `db` on the default port.
# If you add &connection_limit=N, keep N >= 3: the job scheduler holds one
# connection while a job runs.
DATABASE_URL=postgresql://hoard:change_me_to_something_secret@db:5432/hoard?schema=public

# ── Host port binding ───────────────────────────────────────────────────────
# How the app container publishes port 3000 on the host. The default exposes it
# on all interfaces for easy local testing. Behind a reverse proxy / Cloudflare
# Tunnel, bind a unique LOCALHOST port that the proxy targets, e.g.
#   HOARD_PUBLISH=127.0.0.1:3010:3000
HOARD_PUBLISH=3000:3000

# ── TMDB — Movies & TV ──────────────────────────────────────────────────────
# Free key: https://www.themoviedb.org/settings/api  (use the "API Key (v3 auth)")
TMDB_API_KEY=

# ── IGDB — Video Games (via Twitch OAuth) ───────────────────────────────────
# Register an app: https://dev.twitch.tv/console/apps
# IGDB uses a Twitch client-credentials token, minted automatically by the app.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ── Last.fm — Music / Albums ────────────────────────────────────────────────
# Free key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# ── Books ───────────────────────────────────────────────────────────────────
# OpenLibrary is used by default and needs NO key.
# Optionally provide a Google Books key to use Google Books instead:
GOOGLE_BOOKS_API_KEY=

# ── Anime / Manga ───────────────────────────────────────────────────────────
# AniList (https://anilist.co) requires NO key. Nothing to configure here.

# ── Gemini — AI Roast / Recommendations / "Paste a list" import ────────────
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: model override for the roast feature (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ── Trakt — import (optional) ───────────────────────────────────────────────
# Lets Import read a public Trakt profile (watched, ratings, watchlist).
# Create an API app at https://trakt.tv/oauth/applications (any redirect URI,
# e.g. urn:ietf:wg:oauth:2.0:oob) and paste its Client ID. Without it the
# Trakt source shows a "not configured" message.
TRAKT_CLIENT_ID=

# ── Public URL ──────────────────────────────────────────────────────────────
# Where Hoard is reachable from outside. Used for links in notifications (and
# later share/iCal links and OAuth redirects). Optional.
HOARD_PUBLIC_URL=https://hoard.timhufnagel.org

# ── Time zone ───────────────────────────────────────────────────────────────
# Server time zone for scheduled jobs, nightly backups and day boundaries of
# users who haven't picked their own. Optional (default Europe/Berlin).
TZ=Europe/Berlin

# ── Backups ─────────────────────────────────────────────────────────────────
# The `backup` service dumps the database every night into this HOST folder
# (relative to this directory) and the app mounts it read-only. Create it
# before the first `docker compose up`, owned by the UID/GID below, or Docker
# creates it owned by root and the backup service can't write to it:
#   mkdir -p ../backups/hoard
# All optional; the defaults are shown.
HOARD_BACKUP_DIR=../backups/hoard
HOARD_BACKUP_UID=1000
HOARD_BACKUP_GID=1000
# Hour of the nightly backup (0-23, in TZ).
BACKUP_HOUR=3

# ── Scheduler ───────────────────────────────────────────────────────────────
# Set to "off" to disable the in-process job scheduler when running the app
# outside Docker (local debugging only; not passed through docker-compose).
# HOARD_SCHEDULER=off
